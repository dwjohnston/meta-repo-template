{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Container shell",
      "type": "process",
      "command": "${env:SHELL}",
      "args": ["-l", "-i"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "runOptions": {
        "runOn": "folderOpen",
        "instanceLimit": 1
      },
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "echo": false,
        "showReuseMessage": false
      }
    }
  ]
}
